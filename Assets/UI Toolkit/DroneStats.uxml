<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="MainStyle.uss" />
    <ui:VisualElement name="DroneStats" picking-mode="Ignore" class="bg-surface frame frame-lit-left" style="position: absolute; left: 40px; bottom: 40px; width: 400px; padding: 12px 14px 14px 14px;">
        <ui:VisualElement picking-mode="Ignore" class="row divider-bottom" style="align-items: center; margin-bottom: 10px; padding-bottom: 6px;">
            <ui:Label text="DRONE TELEMETRY" picking-mode="Ignore" class="text-accent text-md bold tracking-wide" />
            <ui:VisualElement picking-mode="Ignore" class="bg-hot" style="width: 8px; height: 8px;" />
        </ui:VisualElement>
        <ui:VisualElement picking-mode="Ignore" class="row" style="align-items: flex-end; margin-bottom: 6px;">
            <ui:Label text="SPEED" picking-mode="Ignore" class="text-muted text-sm tracking heavy" />
            <ui:Label name="SpeedValue" text="0.0 M/S" picking-mode="Ignore" class="text-accent text-lg bold" />
        </ui:VisualElement>
        <ui:VisualElement picking-mode="Ignore" class="row" style="align-items: flex-end; margin-bottom: 6px;">
            <ui:Label text="ALTITUDE" picking-mode="Ignore" class="text-muted text-sm tracking heavy" />
            <ui:Label name="AltitudeValue" text="0.0 M" picking-mode="Ignore" class="text-accent text-lg bold" />
        </ui:VisualElement>
        <ui:VisualElement picking-mode="Ignore" class="row" style="align-items: flex-end;">
            <ui:Label text="DISTANCE" picking-mode="Ignore" class="text-muted text-sm tracking heavy" />
            <ui:Label name="DistanceValue" text="0 M" picking-mode="Ignore" class="text-hot text-lg bold" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
