<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="MainStyle.uss" />
    <ui:Template name="DroneStats" src="DroneStats.uxml" />
    <ui:Template name="WorldMarkers" src="WorldMarkers.uxml" />
    <!-- Layers: order in this file is draw order. Every layer is stretched and click-through. -->
    <ui:Instance template="WorldMarkers" name="WorldMarkersLayer" picking-mode="Ignore" class="fill" />
    <ui:Instance template="DroneStats" name="DroneStatsLayer" picking-mode="Ignore" class="fill" />
    <!-- Boresight: static, marks screen centre. A different shape and colour from the
         aim reticle - the two overlap at rest, so they have to stay tellable apart. -->
    <ui:VisualElement name="Boresight" picking-mode="Ignore" style="position: absolute; top: 50%; left: 50%; translate: -50% -50%; width: 30px; height: 30px;">
        <ui:VisualElement picking-mode="Ignore" class="outline-hot" style="position: absolute; top: 50%; left: 50%; margin-top: -10px; margin-left: -10px; width: 20px; height: 20px; rotate: 45deg; border-width: 2px;" />
        <ui:VisualElement picking-mode="Ignore" class="bg-hot" style="position: absolute; top: 50%; left: 50%; margin-top: -2px; margin-left: -2px; width: 4px; height: 4px;" />
    </ui:VisualElement>
    <!-- Aim reticle: code writes left/top in panel pixels every frame; the translate keeps
         the ring centred on that point. Children centre with negative margins instead of a
         second translate. -->
    <ui:VisualElement name="Scope" picking-mode="Ignore" style="position: absolute; top: 50%; left: 50%; translate: -50% -50%; width: 44px; height: 44px;">
        <ui:VisualElement picking-mode="Ignore" class="fill outline-accent round" style="border-width: 2px;" />
        <ui:VisualElement picking-mode="Ignore" class="bg-accent" style="position: absolute; top: -7px; left: 50%; margin-left: -1px; width: 2px; height: 7px;" />
        <ui:VisualElement picking-mode="Ignore" class="bg-accent" style="position: absolute; bottom: -7px; left: 50%; margin-left: -1px; width: 2px; height: 7px;" />
        <ui:VisualElement picking-mode="Ignore" class="bg-accent" style="position: absolute; left: -7px; top: 50%; margin-top: -1px; width: 7px; height: 2px;" />
        <ui:VisualElement picking-mode="Ignore" class="bg-accent" style="position: absolute; right: -7px; top: 50%; margin-top: -1px; width: 7px; height: 2px;" />
        <ui:VisualElement picking-mode="Ignore" class="bg-accent round" style="position: absolute; top: 50%; left: 50%; margin-top: -2px; margin-left: -2px; width: 4px; height: 4px;" />
    </ui:VisualElement>
</ui:UXML>
