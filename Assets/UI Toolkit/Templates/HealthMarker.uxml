<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../MainStyle.uss" />
    <!-- Code writes left/top every frame; the translate centres the bar on that point. -->
    <ui:VisualElement name="Marker" picking-mode="Ignore" class="bg-surface frame" style="position: absolute; translate: -50% -50%; width: 110px; height: 12px; padding: 2px; border-radius: 6px;">
        <ui:VisualElement name="Fill" picking-mode="Ignore" class="bg-hot" style="height: 100%; width: 100%; border-radius: 3px;" />
    </ui:VisualElement>
</ui:UXML>
