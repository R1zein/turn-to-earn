<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="MainStyle.uss" />
    <ui:Template name="ResourceMarks" src="Templates/ResourceMarks.uxml" />
    <!-- One window for every structure the player interacts with (E). The header is the
         structure itself; below are the tabs it has: what it does (BOTS and BASE at the
         shop table) and what it can turn into (MODIFY). -->
    <ui:VisualElement name="StructureWindow" class="fill center hidden" picking-mode="Ignore">
        <ui:VisualElement class="bg-surface frame frame-lit-left" style="width: 1240px; padding: 18px 24px 20px 24px;">
            <ui:VisualElement class="divider-bottom" style="flex-direction: row; align-items: center; margin-bottom: 14px; padding-bottom: 12px;">
                <ui:VisualElement name="WindowIcon" picking-mode="Ignore" style="width: 84px; height: 84px; margin-right: 18px; border-radius: 10px; -unity-background-scale-mode: scale-to-fit;" />
                <ui:VisualElement picking-mode="Ignore" style="width: 380px;">
                    <ui:Label name="WindowTitle" text="WALL" picking-mode="Ignore" class="text-accent text-lg bold tracking-wide" style="margin-bottom: 4px;" />
                    <ui:VisualElement picking-mode="Ignore" style="flex-direction: row; align-items: flex-end; margin-bottom: 6px;">
                        <ui:Label text="HP" picking-mode="Ignore" class="text-muted text-sm tracking heavy" style="margin-right: 10px;" />
                        <ui:Label name="WindowHealth" text="1000 / 1000" picking-mode="Ignore" class="text-accent text-md bold" />
                    </ui:VisualElement>
                    <ui:VisualElement picking-mode="Ignore" class="frame" style="height: 14px; padding: 2px; border-radius: 7px;">
                        <ui:VisualElement name="WindowHealthFill" picking-mode="Ignore" class="bg-accent" style="height: 100%; width: 100%; border-radius: 4px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1;" />
                <ui:Label text="E / ESC - CLOSE" picking-mode="Ignore" class="text-muted text-sm tracking heavy" style="margin-right: 20px;" />
                <ui:Button name="CloseButton" text="CLOSE" class="btn" />
            </ui:VisualElement>
            <!-- A tab and its page are named "<name>Tab" and "<name>Page" after an
                 IStructureTab; only the tabs the structure has are shown. -->
            <ui:VisualElement style="flex-direction: row; margin-bottom: 12px;">
                <ui:Button name="BotsTab" text="BOTS" class="btn" style="margin-right: 10px; padding: 10px 22px;" />
                <ui:Button name="BaseTab" text="BASE" class="btn" style="margin-right: 10px; padding: 10px 22px;" />
                <ui:Button name="ModifyTab" text="MODIFY" class="btn" style="margin-right: 10px; padding: 10px 22px;" />
            </ui:VisualElement>
            <ui:VisualElement style="min-height: 400px;">
                <!-- Each list is filled from the ItemCard template. -->
                <ui:VisualElement name="BotsPage">
                    <ui:VisualElement name="BotOptions" class="row" style="justify-content: center;" />
                </ui:VisualElement>
                <ui:VisualElement name="BasePage">
                    <ui:Label name="BaseHint" text="CHOOSE WHERE TO BUILD THE BASE" class="text-muted text-sm tracking heavy" style="-unity-text-align: middle-center; margin-bottom: 6px;" />
                    <ui:VisualElement name="FortificationOptions" class="row" style="justify-content: center;" />
                    <ui:VisualElement name="PartOptions" class="row" style="justify-content: center;" />
                </ui:VisualElement>
                <!-- Cards from the BuildCard template, one per upgrade of the structure;
                     the card under the mouse is described below them. -->
                <ui:VisualElement name="ModifyPage" style="flex-grow: 1;">
                    <ui:VisualElement name="UpgradeOptions" style="flex-grow: 1; flex-direction: row; flex-wrap: wrap; align-content: flex-start;" />
                    <ui:VisualElement name="UpgradeDetail" class="divider-top" style="flex-direction: row; align-items: center; margin-top: 10px; padding-top: 12px; min-height: 112px;">
                        <ui:VisualElement name="UpgradeIcon" picking-mode="Ignore" style="width: 96px; height: 96px; margin-right: 18px; border-radius: 10px; -unity-background-scale-mode: scale-to-fit;" />
                        <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; flex-shrink: 1;">
                            <ui:Label name="UpgradeTitle" text="TITLE" picking-mode="Ignore" class="text-accent text-md bold tracking-wide" />
                            <ui:Label name="UpgradeDescription" text="DESCRIPTION" picking-mode="Ignore" class="text-muted text-sm tracking heavy" style="margin-top: 6px; white-space: normal;" />
                        </ui:VisualElement>
                        <ui:VisualElement picking-mode="Ignore" style="align-items: flex-end; margin-left: 20px;">
                            <ui:Label name="UpgradeHint" text="CLICK - UPGRADE AND PAY" picking-mode="Ignore" class="text-muted text-sm tracking heavy" />
                            <ui:Instance template="ResourceMarks" name="UpgradePrice" picking-mode="Ignore" style="margin-top: 6px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
